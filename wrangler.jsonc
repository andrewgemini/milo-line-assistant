{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milo-line-assistant",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "MiloContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MILO_CONTAINER",
        "class_name": "MiloContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MiloContainer"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "0 0 * * *", "0 13 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
