{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{api/tessdata/**,client/public/richmenu/**,client/public/milo-richmenu/**,models/transformers-cache/**}",
      "excludeFiles": "{node_modules/**/onnxruntime-node/bin/**/darwin/**,node_modules/**/onnxruntime-node/bin/**/win32/**,node_modules/**/onnxruntime-node/bin/**/linux/arm64/**}"
    }
  }
}
